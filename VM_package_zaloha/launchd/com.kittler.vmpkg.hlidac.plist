<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kittler.vmpkg.hlidac</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/martinkittler/VM_Safety/bin/hlidac_zaloh.sh</string>
  </array>
  <!-- Každou hodinu — aby stíhal logiku „výpadek → za 2 h retry → +1 h teprve notifikace". -->
  <key>StartInterval</key><integer>3600</integer>
  <key>StandardOutPath</key><string>/Users/martinkittler/VM_Safety/agent.log</string>
  <key>StandardErrorPath</key><string>/Users/martinkittler/VM_Safety/agent.err</string>
</dict>
</plist>
