<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kittler.vmpkg.cold</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/martinkittler/VM_Safety/bin/zaloha_vm_package.sh</string>
    <string>cold</string>
  </array>
  <!-- DO PONDĚLÍ (interní disk, malá kapacita): 2× denně 06:00 + 18:00, retence 1.
       OD PONDĚLÍ (Thunderbolt): přidej zpět 13:00 → 3× denně a v config.sh RETAIN_COLD=4. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/martinkittler/VM_Safety/agent.log</string>
  <key>StandardErrorPath</key><string>/Users/martinkittler/VM_Safety/agent.err</string>
</dict>
</plist>
