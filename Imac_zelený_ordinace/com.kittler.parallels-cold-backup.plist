<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kittler.parallels-cold-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/martinkittler/Parallels_Backup_ordinace/parallels_cold_backup.sh</string>
    </array>

    <!-- Jen v pracovní dny Po/St/Pá v 07:00 (přání Martina 5.9.2026, bez víkendu).
         Weekday: 1=Po, 3=St, 5=Pá. Pokud iMac spí, launchd doběhne po probuzení. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/martinkittler/Parallels_Backup_ordinace/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/martinkittler/Parallels_Backup_ordinace/launchd.err.log</string>
</dict>
</plist>
