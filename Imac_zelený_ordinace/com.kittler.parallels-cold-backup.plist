<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kittler.parallels-cold-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/martinkittler/Parallels_Backup_ordinace/parallels_cold_backup.sh</string>
    </array>

    <!-- Jen 1x TÝDNĚ: pátek 16:45 (přání Martina 22.9.2026 — méně zátěže na síť v ordinaci).
         Lokální cold se udělá chvíli před přenosem; NAS push se pustí ŘETĚZENĚ hned po coldu
         (~17:00). Lokální zrcadlo (retence 1) zůstane až do dalšího pátku. Weekday 5=Pá.
         Pokud iMac spí, launchd doběhne po probuzení. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>5</integer>
        <key>Hour</key><integer>16</integer>
        <key>Minute</key><integer>45</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/martinkittler/Parallels_Backup_ordinace/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/martinkittler/Parallels_Backup_ordinace/launchd.err.log</string>
</dict>
</plist>
