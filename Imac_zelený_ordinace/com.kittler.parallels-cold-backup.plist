<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kittler.parallels-cold-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/martinkittler/Parallels_Backup_ordinace/parallels_cold_backup.sh</string>
    </array>

    <!-- Denně ve 12:00 (kolem poledne). Pokud iMac spí, launchd doběhne po probuzení. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>12</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/martinkittler/Parallels_Backup_ordinace/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/martinkittler/Parallels_Backup_ordinace/launchd.err.log</string>
</dict>
</plist>
